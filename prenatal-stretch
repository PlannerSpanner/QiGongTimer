<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Prenatal Stretch">
<meta name="theme-color" content="#fdf4f1">
<title>Prenatal Stretch</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;
  background:linear-gradient(160deg,#fdf4f1 0%,#fbecf1 42%,#f1eefa 100%);
  color:#4c3d43;padding:16px;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}
.container{width:100%;max-width:400px;text-align:center}
h1{font-size:1.2rem;font-weight:400;letter-spacing:3px;text-transform:uppercase;color:#a8546b;margin-bottom:4px}
.subtitle{font-size:0.63rem;letter-spacing:2px;color:#a98b95;margin-bottom:10px;text-transform:uppercase}
.safety-banner{font-size:0.67rem;line-height:1.55;color:#8f4550;background:rgba(214,110,120,0.11);border:1px solid rgba(214,110,120,0.3);border-radius:11px;padding:10px 13px;margin-bottom:16px;text-align:left}
.safety-banner strong{color:#7d353f}
.ring-container{position:relative;width:210px;height:210px;margin:0 auto 12px}
.ring-bg{fill:none;stroke:#f2dfe4;stroke-width:6}
.ring-progress{fill:none;stroke:#d9788f;stroke-width:6;stroke-linecap:round;transition:stroke-dashoffset 0.3s linear}
.timer-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center}
.time-display{font-size:2.7rem;font-weight:200;letter-spacing:2px;color:#4c3d43;font-variant-numeric:tabular-nums}
.movement-number{font-size:0.68rem;letter-spacing:3px;color:#c4657f;margin-bottom:2px}
.movement-name{font-size:1.02rem;font-weight:600;color:#7d3f53;margin-bottom:3px;min-height:24px;display:flex;align-items:center;justify-content:center;line-height:1.3;padding:0 8px}
.movement-target{font-size:0.71rem;color:#a1808b;margin-bottom:6px;font-style:italic}
.side-badge{display:none;font-size:0.61rem;letter-spacing:2px;color:#b05a76;background:rgba(255,255,255,0.75);border:1px solid rgba(190,120,140,0.3);border-radius:20px;padding:3px 12px;margin-bottom:8px}
.side-badge.visible{display:inline-block}
.video-buttons{display:flex;gap:8px;justify-content:center;margin-bottom:10px;flex-wrap:wrap}
.video-link{display:none;text-decoration:none}
.video-link-inner{display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,0.8);color:#c0392b;font-size:0.71rem;padding:6px 14px;border-radius:50px;border:1px solid rgba(192,57,43,0.22)}
.video-link-inner svg{width:14px;height:14px;fill:currentColor}
.search-link{display:none;text-decoration:none}
.search-link-inner{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,0.65);color:#96737f;font-size:0.67rem;padding:6px 14px;border-radius:50px;border:1px solid rgba(150,115,127,0.2)}
.progress-dots{display:flex;justify-content:center;gap:7px;margin-bottom:13px;flex-wrap:wrap}
.dot{width:10px;height:10px;border-radius:50%;background:#eedde3;transition:all 0.4s}
.dot.active{background:#d9788f;box-shadow:0 0 8px rgba(217,120,143,0.45)}
.dot.done{background:#e8b6c4}
.nav-controls{display:none;gap:12px;justify-content:center;align-items:center;margin-bottom:12px}
.nav-controls.visible{display:flex}
.btn-nav{background:rgba(255,255,255,0.75);color:#a8546b;font-size:0.85rem;padding:10px 18px;border:1px solid rgba(168,84,107,0.2);display:flex;align-items:center;gap:4px}
.btn-nav:active{background:rgba(255,255,255,1)}
.btn-nav:disabled{opacity:0.3;pointer-events:none}
.btn-nav svg{width:14px;height:14px;fill:currentColor}
.nav-label{font-size:0.65rem;color:#a98b95;letter-spacing:1px}
.controls{display:flex;gap:12px;justify-content:center;margin-bottom:10px}
button{border:none;border-radius:50px;cursor:pointer;font-family:inherit;transition:all 0.2s;-webkit-tap-highlight-color:transparent}
.btn-primary{background:#d9788f;color:#fff;font-size:1rem;font-weight:600;padding:12px 36px;letter-spacing:1px;box-shadow:0 2px 6px rgba(217,120,143,0.28)}
.btn-primary:active{transform:scale(0.96);background:#c4657f}
.btn-secondary{background:rgba(255,255,255,0.75);color:#a8546b;font-size:0.8rem;padding:8px 20px;border:1px solid rgba(168,84,107,0.2)}
.btn-secondary:active{background:rgba(255,255,255,1)}
.btn-secondary.active-toggle{background:rgba(217,120,143,0.14);border-color:rgba(217,120,143,0.45);color:#a8546b}
.form-cue{padding:11px 14px;background:rgba(255,255,255,0.62);border-radius:11px;border:1px solid rgba(150,115,127,0.16);font-size:0.73rem;color:#6b555d;line-height:1.55;text-align:left;min-height:50px}
.form-cue strong{color:#a8546b}
.state-complete .movement-name{color:#c4657f;font-size:1.2rem}
.total-time{font-size:0.66rem;color:#a98b95;letter-spacing:1px;margin-top:8px}
.note{margin-top:12px;padding:11px 14px;background:rgba(255,255,255,0.5);border-radius:11px;border:1px solid rgba(150,115,127,0.14);font-size:0.68rem;color:#7d6670;line-height:1.55;text-align:left}
.note strong{color:#a8546b}
</style>
</head>
<body>
<div class="container" id="app">
  <h1>Prenatal Stretch</h1>
  <div class="subtitle">Gentle · Low-lying placenta safe · 10 min</div>
  <div class="safety-banner">
    <strong>Stop immediately</strong> and call your provider for any vaginal bleeding, cramping, contractions, fluid leaking, dizziness, or sharp pain. Get clearance from your OB or midwife before starting. Nothing here should ever feel like straining.
  </div>
  <div class="ring-container">
    <svg width="210" height="210" viewBox="0 0 210 210">
      <circle class="ring-bg" cx="105" cy="105" r="92"/>
      <circle class="ring-progress" id="ring" cx="105" cy="105" r="92"
        stroke-dasharray="578.05" stroke-dashoffset="0"
        transform="rotate(-90 105 105)"/>
    </svg>
    <div class="timer-text">
      <div class="movement-number" id="movNum">READY</div>
      <div class="time-display" id="timeDisp">0:00</div>
    </div>
  </div>
  <div class="movement-name" id="movName">Tap Start to begin</div>
  <div class="movement-target" id="movTarget"></div>
  <div class="side-badge" id="sideBadge">BOTH SIDES · SWITCH AT HALFWAY</div>
  <div class="video-buttons">
    <a class="video-link" id="videoLink" href="#" target="_blank" rel="noopener">
      <span class="video-link-inner">
        <svg viewBox="0 0 24 24"><path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/></svg>
        Watch form
      </span>
    </a>
    <a class="search-link" id="searchLink" href="#" target="_blank" rel="noopener">
      <span class="search-link-inner">Find more demos</span>
    </a>
  </div>
  <div class="progress-dots" id="dots"></div>
  <div class="nav-controls" id="navControls">
    <button class="btn btn-nav" id="prevBtn" onclick="prevMovement()" disabled>
      <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      Prev
    </button>
    <span class="nav-label" id="navLabel"></span>
    <button class="btn btn-nav" id="nextBtn" onclick="nextMovement()">
      Next
      <svg viewBox="0 0 24 24"><path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg>
    </button>
  </div>
  <div class="controls">
    <button class="btn-primary" id="mainBtn" onclick="toggleTimer()">Start</button>
    <button class="btn-secondary active-toggle" id="voiceBtn" onclick="toggleVoice()">Voice On</button>
  </div>
  <div class="controls">
    <button class="btn-secondary" id="resetBtn" onclick="resetTimer()" style="display:none">Reset</button>
  </div>
  <div class="form-cue" id="formCue">
    <strong>About this routine:</strong> Every position is seated, side-lying, hands-and-knees, or standing with support — no lying flat on the back, no inversions, no balance challenges. Breathe continuously throughout. Never hold your breath.
  </div>
  <div class="total-time" id="totalTime"></div>
</div>

<script>
const movements = [
  {
    num: 1, name: "Seated breathing", duration: 60, bilateral: false,
    target: "Settle in · rib and diaphragm expansion",
    cue: "<strong>Form:</strong> Sit tall on a chair or birth ball, feet flat and wide. Breathe in through the nose and feel the ribs widen sideways, not the chest lifting. Long, slow exhale through the mouth. <strong>Why:</strong> As the uterus grows it crowds the diaphragm. Training sideways rib expansion keeps breathing efficient and reduces the shortness of breath that builds through the third trimester.",
    searchQuery: "prenatal+diaphragmatic+breathing+rib+expansion"
  },
  {
    num: 2, name: "Seated cat-cow", duration: 45, bilateral: false,
    target: "Spinal mobility · low back relief",
    cue: "<strong>Form:</strong> Hands on knees. Round the spine and tuck the pelvis on the exhale, then arch gently and open the chest on the inhale. Slow and small. <strong>Why:</strong> The growing belly pulls the pelvis into a forward tilt, compressing the low back. Moving through both directions relieves that and keeps the lumbar spine mobile.",
    searchQuery: "seated+cat+cow+pregnancy+stretch"
  },
  {
    num: 3, name: "Seated side reach", duration: 60, bilateral: true,
    target: "Ribs, obliques, and side body",
    cue: "<strong>Form:</strong> Seated tall. Reach one arm overhead and lean gently to the opposite side. Keep both sit bones down. Breathe into the stretched side. Switch at the halfway chime. <strong>Why:</strong> Creates space between the ribs and hips — one of the most compressed areas in later pregnancy, and it makes room for the diaphragm.",
    searchQuery: "seated+side+stretch+pregnancy+ribs"
  },
  {
    num: 4, name: "Seated figure-4", duration: 60, bilateral: true,
    target: "Glutes and piriformis · sciatic relief",
    cue: "<strong>Form:</strong> Seated, ankle across the opposite knee. Sit tall and hinge forward slightly from the hips until you feel the outer hip open. Switch at the halfway chime. <strong>Why:</strong> Pregnancy loosens the pelvic ligaments and the piriformis often tightens to compensate, which can irritate the sciatic nerve. This is the direct antidote.",
    searchQuery: "seated+figure+four+piriformis+stretch+pregnancy"
  },
  {
    num: 5, name: "Supported butterfly", duration: 60, bilateral: false,
    target: "Inner thighs · pelvic outlet",
    cue: "<strong>Form:</strong> Sit on a cushion or folded blanket so the hips are above the knees. Soles of the feet together, knees falling open. Let gravity do the work — do not push the knees down. <strong>Why:</strong> Adductor flexibility directly affects how wide the pelvic outlet can open during birth. Gentle, consistent, never forced — the ligaments are already softened by relaxin, so aggressive stretching can destabilize the pelvis.",
    searchQuery: "supported+bound+angle+butterfly+pose+pregnancy"
  },
  {
    num: 6, name: "Wide-knee child's pose", duration: 60, bilateral: false,
    target: "Low back, hips, and pelvic floor release",
    cue: "<strong>Form:</strong> Kneel with knees wide and big toes together, sit back toward the heels. Rest your forearms or a cushion under your chest. Belly hangs comfortably in the space between the knees. <strong>Why:</strong> This is one of the best positions for letting the pelvic floor lengthen and release — the exact quality you want available on birth day.",
    searchQuery: "wide+knee+childs+pose+pregnancy+modification"
  },
  {
    num: 7, name: "Hands-and-knees rocking", duration: 60, bilateral: false,
    target: "Pelvic mobility · baby positioning",
    cue: "<strong>Form:</strong> On hands and knees, wrists under shoulders. Rock the hips slowly forward and back, then in gentle circles. Keep the spine neutral — no deep arching. <strong>Why:</strong> Takes the baby's weight off the spine and encourages an optimal anterior fetal position, which is associated with shorter labors and less back labor.",
    searchQuery: "hands+and+knees+pelvic+rocking+pregnancy"
  },
  {
    num: 8, name: "Kneeling hip flexor stretch", duration: 60, bilateral: true,
    target: "Hip flexors · anterior pelvis",
    cue: "<strong>Form:</strong> Half-kneeling with one foot forward, cushion under the back knee. Tuck the pelvis slightly, then shift weight gently forward. Hold a chair for support. Switch at the halfway chime. <strong>Why:</strong> Tight hip flexors tilt the pelvis forward and worsen back pain. Releasing them also helps the pelvic outlet open.",
    searchQuery: "kneeling+hip+flexor+stretch+pregnancy+safe"
  },
  {
    num: 9, name: "Standing calf stretch", duration: 60, bilateral: true,
    target: "Calves · cramping and swelling",
    cue: "<strong>Form:</strong> Hands on a wall or counter, one foot back with the heel pressing down. Keep the back leg straight. Switch at the halfway chime. <strong>Why:</strong> Calf cramps and swelling are among the most common second and third trimester complaints. Stretching plus the muscle pump action helps both.",
    searchQuery: "standing+calf+stretch+wall+pregnancy"
  },
  {
    num: 10, name: "Doorway chest opener", duration: 45, bilateral: false,
    target: "Chest and shoulders · posture",
    cue: "<strong>Form:</strong> Forearms on a doorframe at shoulder height, step one foot through gently. Feel the chest open. Do not lean hard — a mild stretch is plenty. <strong>Why:</strong> Breast growth and the forward weight shift round the shoulders. Opening the chest relieves upper back tension and gives the lungs more room.",
    searchQuery: "doorway+chest+stretch+pregnancy+posture"
  },
  {
    num: 11, name: "Side-lying rest", duration: 60, bilateral: false,
    target: "Recovery · circulation",
    cue: "<strong>Form:</strong> Lie on your left side with a pillow between the knees and one supporting the belly. Slow breathing. Nothing to do here. <strong>Why:</strong> Left side-lying maximizes blood flow to the placenta by keeping pressure off the vena cava. This is both a rest position and a useful habit to build for sleeping.",
    searchQuery: "left+side+lying+position+pregnancy+pillow+support"
  }
];

let timeLeft=0,currentMove=0,running=false,interval=null,voiceOn=true,audioCtx=null,wakeLock=null,switchCalled=false;
const ring=document.getElementById('ring'),timeDisp=document.getElementById('timeDisp'),movNum=document.getElementById('movNum'),movName=document.getElementById('movName'),movTarget=document.getElementById('movTarget'),sideBadge=document.getElementById('sideBadge'),mainBtn=document.getElementById('mainBtn'),voiceBtn=document.getElementById('voiceBtn'),resetBtn=document.getElementById('resetBtn'),dotsEl=document.getElementById('dots'),formCue=document.getElementById('formCue'),videoLink=document.getElementById('videoLink'),searchLink=document.getElementById('searchLink'),navControls=document.getElementById('navControls'),prevBtn=document.getElementById('prevBtn'),nextBtn=document.getElementById('nextBtn'),navLabel=document.getElementById('navLabel'),circumference=2*Math.PI*92;

movements.forEach((_,i)=>{const d=document.createElement('div');d.className='dot';d.id='dot'+i;dotsEl.appendChild(d);});

async function requestWakeLock(){try{if('wakeLock'in navigator){wakeLock=await navigator.wakeLock.request('screen');wakeLock.addEventListener('release',()=>{wakeLock=null;});}}catch(e){}}
function releaseWakeLock(){if(wakeLock){wakeLock.release();wakeLock=null;}}
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&running){requestWakeLock();}});

function getAudioCtx(){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();return audioCtx;}
function playChime(freq,vol,dur){try{const ctx=getAudioCtx();if(ctx.state==='suspended')ctx.resume();const osc=ctx.createOscillator();const gain=ctx.createGain();osc.type='sine';osc.frequency.setValueAtTime(freq,ctx.currentTime);gain.gain.setValueAtTime(0,ctx.currentTime);gain.gain.linearRampToValueAtTime(vol,ctx.currentTime+0.05);gain.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+dur);osc.connect(gain);gain.connect(ctx.destination);osc.start(ctx.currentTime);osc.stop(ctx.currentTime+dur);}catch(e){}}
function transitionChime(){playChime(392,0.1,1.2);setTimeout(()=>playChime(523.25,0.08,1.0),200);setTimeout(()=>playChime(659.25,0.06,0.8),400);}
function switchChime(){playChime(587.33,0.09,0.5);setTimeout(()=>playChime(587.33,0.09,0.5),300);}
function completionChime(){playChime(392,0.1,1.5);setTimeout(()=>playChime(523.25,0.09,1.2),250);setTimeout(()=>playChime(659.25,0.08,1.2),500);setTimeout(()=>playChime(783.99,0.07,2.0),750);}
function speak(text){if(!voiceOn)return;try{const u=new SpeechSynthesisUtterance(text);u.rate=0.8;u.pitch=0.95;u.volume=0.8;speechSynthesis.speak(u);}catch(e){}}

function updateDisplay(){const m=movements[currentMove];const dur=m?m.duration:0;const mins=Math.floor(timeLeft/60);const secs=timeLeft%60;timeDisp.textContent=mins+':'+String(secs).padStart(2,'0');if(dur>0){const progress=1-(timeLeft/dur);ring.style.strokeDashoffset=circumference*(1-progress);}}
function updateVideoLinks(m){videoLink.href='https://www.youtube.com/results?search_query='+m.searchQuery;videoLink.style.display='inline-block';searchLink.href='https://www.youtube.com/results?search_query='+m.searchQuery+'+prenatal';searchLink.style.display='inline-block';}
function updateNavButtons(){prevBtn.disabled=currentMove<=0;nextBtn.disabled=currentMove>=movements.length-1;navLabel.textContent=(currentMove+1)+' / '+movements.length;navControls.classList.add('visible');}
function prevMovement(){if(currentMove<=0)return;startMovement(currentMove-1);}
function nextMovement(){if(currentMove>=movements.length-1)return;startMovement(currentMove+1);}

function startMovement(index){
  currentMove=index;const m=movements[index];timeLeft=m.duration;switchCalled=false;
  movNum.textContent='STRETCH '+m.num+' OF '+movements.length;
  movName.textContent=m.name;movTarget.textContent=m.target;
  sideBadge.classList.toggle('visible',!!m.bilateral);
  formCue.innerHTML=m.cue;updateVideoLinks(m);updateNavButtons();
  movements.forEach((_,i)=>{document.getElementById('dot'+i).className='dot'+(i<index?' done':i===index?' active':'');});
  transitionChime();setTimeout(()=>speak(m.name+(m.bilateral?'. Start with your right side.':'')),500);updateDisplay();
}

function tick(){
  timeLeft--;updateDisplay();
  const m=movements[currentMove];
  if(m&&m.bilateral&&!switchCalled&&timeLeft===Math.floor(m.duration/2)){switchCalled=true;switchChime();setTimeout(()=>speak('Switch sides'),300);}
  if(timeLeft===5)playChime(340,0.04,0.3);
  if(timeLeft<=0){if(currentMove<movements.length-1)startMovement(currentMove+1);else completeSession();}
}

function completeSession(){
  clearInterval(interval);interval=null;running=false;releaseWakeLock();
  movements.forEach((_,i)=>{document.getElementById('dot'+i).className='dot done';});
  movNum.textContent='COMPLETE';movName.textContent='Stretch complete';
  movTarget.textContent='';sideBadge.classList.remove('visible');
  timeDisp.textContent='\u2713';ring.style.strokeDashoffset=0;
  document.querySelector('.container').classList.add('state-complete');
  mainBtn.style.display='none';resetBtn.style.display='';
  videoLink.style.display='none';searchLink.style.display='none';
  navControls.classList.remove('visible');
  formCue.innerHTML='<strong>Done.</strong> Drink water. If anything felt sharp, pulling, or made you dizzy, mention it at your next appointment.';
  completionChime();setTimeout(()=>speak('Stretch complete.'),600);
}

function toggleTimer(){
  if(!running){running=true;mainBtn.textContent='Pause';resetBtn.style.display='';requestWakeLock();getAudioCtx();if(audioCtx.state==='suspended')audioCtx.resume();if(currentMove===0&&timeLeft===0)startMovement(0);interval=setInterval(tick,1000);}
  else{running=false;clearInterval(interval);interval=null;releaseWakeLock();mainBtn.textContent='Resume';}
}
function toggleVoice(){voiceOn=!voiceOn;voiceBtn.textContent=voiceOn?'Voice On':'Voice Off';voiceBtn.classList.toggle('active-toggle',voiceOn);}
function resetTimer(){
  clearInterval(interval);interval=null;running=false;releaseWakeLock();currentMove=0;timeLeft=0;switchCalled=false;
  document.querySelector('.container').classList.remove('state-complete');
  movNum.textContent='READY';movName.textContent='Tap Start to begin';movTarget.textContent='';
  sideBadge.classList.remove('visible');
  mainBtn.textContent='Start';mainBtn.style.display='';resetBtn.style.display='none';
  videoLink.style.display='none';searchLink.style.display='none';navControls.classList.remove('visible');
  ring.style.strokeDashoffset=0;timeDisp.textContent='0:00';
  formCue.innerHTML='<strong>About this routine:</strong> Every position is seated, side-lying, hands-and-knees, or standing with support \u2014 no lying flat on the back, no inversions, no balance challenges. Breathe continuously throughout. Never hold your breath.';
  movements.forEach((_,i)=>{document.getElementById('dot'+i).className='dot';});
}
const totalSec=movements.reduce((s,m)=>s+m.duration,0);
document.getElementById('totalTime').textContent='Total: '+Math.floor(totalSec/60)+':'+String(totalSec%60).padStart(2,'0');
</script>
</body>
</html>
